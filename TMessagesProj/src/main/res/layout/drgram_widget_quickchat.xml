<?xml version="1.0" encoding="utf-8"?>
<!-- DrGram Fix 80: Quick Chat home widget — dark glass, gold accents -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/drgram_widget_bg">

    <TextView
        android:id="@+id/drgram_qw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFF4D27A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/drgram_qw_open"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:textColor="#FFF1EADA"
        android:textSize="14sp"
        android:background="#33F4D27A"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/drgram_qw_replies"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:textColor="#FFF1EADA"
        android:textSize="14sp"
        android:background="#33F4D27A"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/drgram_qw_saved"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:textColor="#FFF1EADA"
        android:textSize="14sp"
        android:background="#33F4D27A" />
</LinearLayout>
